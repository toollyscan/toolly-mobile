{
  "schema_version": 1,
  "policy_id": "toolly-platform-parity",
  "platforms": [
    "android",
    "ios"
  ],
  "form_factors": {
    "android": [
      "phone",
      "tablet"
    ],
    "ios": [
      "iphone",
      "ipad"
    ]
  },
  "shared_ui": {
    "framework": "compose-multiplatform",
    "scope": "toolly-owned-non-system-screens",
    "locales": [
      "en-IN",
      "hi-IN",
      "kn-IN"
    ]
  },
  "allowed_platform_differences": [
    {
      "id": "capture-engine",
      "android_adapter": "ml-kit-or-camerax",
      "ios_adapter": "visionkit-or-avfoundation",
      "shared_contract": "com.toolly.shared.capture.DocumentScanner"
    },
    {
      "id": "key-protection",
      "android_adapter": "android-keystore",
      "ios_adapter": "apple-keychain",
      "shared_contract": "KeyProtector"
    },
    {
      "id": "system-surfaces",
      "android_adapter": "android-system-ui",
      "ios_adapter": "apple-system-ui",
      "shared_contract": "PlatformAction"
    },
    {
      "id": "notifications",
      "android_adapter": "fcm-android",
      "ios_adapter": "apns-via-fcm",
      "shared_contract": "NotificationGateway"
    },
    {
      "id": "store-purchases",
      "android_adapter": "google-play-billing",
      "ios_adapter": "storekit",
      "shared_contract": "EntitlementProvider"
    }
  ],
  "features": [
    {
      "id": "document-library",
      "android": "candidate",
      "ios": "candidate",
      "gap_reason": "The first-party iOS host launches the shared library surface in iPhone and iPad simulators; physical-device evidence remains pending.",
      "tracking_issue": 49
    },
    {
      "id": "capture-review",
      "android": "candidate",
      "ios": "in-progress",
      "gap_reason": "The provider-neutral capture contract now compiles for Android and iOS; the first-party Apple adapter and physical-device evidence remain pending.",
      "tracking_issue": 48
    },
    {
      "id": "document-viewer",
      "android": "candidate",
      "ios": "candidate",
      "gap_reason": "The first-party iOS host launches the shared viewer surface in iPhone and iPad simulators; physical-device evidence remains pending.",
      "tracking_issue": 49
    },
    {
      "id": "encrypted-local-vault",
      "android": "candidate",
      "ios": "pending",
      "gap_reason": "Android platform-only encrypted repository is merged; Apple adapter and interoperability evidence remain pending.",
      "tracking_issue": 26
    },
    {
      "id": "pdf-jpeg-export",
      "android": "candidate",
      "ios": "pending",
      "gap_reason": "Android platform export is an executable candidate; Apple adapter and cross-platform output evidence remain pending.",
      "tracking_issue": 24
    },
    {
      "id": "authentication",
      "android": "pending",
      "ios": "pending",
      "gap_reason": null,
      "tracking_issue": 38
    },
    {
      "id": "notifications",
      "android": "pending",
      "ios": "pending",
      "gap_reason": null,
      "tracking_issue": 38
    },
    {
      "id": "subscriptions",
      "android": "pending",
      "ios": "pending",
      "gap_reason": null,
      "tracking_issue": 38
    },
    {
      "id": "localization",
      "android": "implemented",
      "ios": "candidate",
      "gap_reason": "The shared localized resources compile into the launched iOS host; native-language and physical-device review evidence remain pending.",
      "tracking_issue": 49
    },
    {
      "id": "accessibility",
      "android": "in-progress",
      "ios": "in-progress",
      "gap_reason": "Shared semantics exist; TalkBack and VoiceOver physical-device evidence remains pending.",
      "tracking_issue": 49
    }
  ]
}
