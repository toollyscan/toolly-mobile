        "firestoreReads": 25,
        "firestoreWrites": 8,
        "firestoreDeletes": 0.2,
        "functionInvocations": 4,
        "storageGiBMonth": 0,
        "storageUploadGiB": 0,
        "storageDownloadGiB": 0,
        "fcmMessages": 0.5
