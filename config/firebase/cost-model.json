      "notes": "Free users have no cloud document backup; only minimum identity, entitlement and security operations are modelled."
    },
    {
      "id": "premium-base",
      "status": "hypothesis",
      "monthlyPerActiveUser": {
        "otpSms": 0.25,
        "authActiveUsers": 1,
        "firestoreReads": 180,
        "firestoreWrites": 70,
        "firestoreDeletes": 2,
        "functionInvocations": 35,
        "storageGiBMonth": 1,
