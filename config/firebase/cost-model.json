      "id": "premium-allowance-edge",
      "status": "hypothesis",
      "monthlyPerActiveUser": {
        "otpSms": 0.25,
        "authActiveUsers": 1,
        "firestoreReads": 600,
        "firestoreWrites": 220,
        "firestoreDeletes": 8,
        "functionInvocations": 100,
