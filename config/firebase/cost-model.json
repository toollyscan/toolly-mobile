  "calculation": {
    "perScenario": "sum(max(0, usage_quantity - allocated_free_tier_share) * effective_regional_sku_price) + allocated_fixed_cost",
    "monthlyCohort": "active_users * per_user_variable_cost + cohort_fixed_cost",
    "grossMargin": "(net_subscription_revenue - cloud_cost - store_fee - tax_and_support_allocations) / net_subscription_revenue",
    "requiredSensitivityAxes": [
      "active-users",
      "free-to-premium-ratio",
      "otp-rate",
      "stored-gib",
      "upload-and-download-gib",
      "firestore-read-amplification",
      "function-retry-amplification",
      "region-and-edition",
      "tax-and-currency"
    ]
  },
  "budgetPolicy": {
    "budgetsAreHardCaps": false,
